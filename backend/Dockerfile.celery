# Use lightweight Python image
FROM python:3.13-slim AS base

# Set environment variables for security & performance
ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# Create a non-root user for security
RUN addgroup --system celery && adduser --system --ingroup celery celery

# Install necessary system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    gcc \
    g++ \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*  # Cleanup package manager cache

# Install dependencies separately for better caching
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY . .

# Change ownership to non-root user
RUN chown -R celery:celery /app
USER celery

# Define entrypoint for Celery worker
ENTRYPOINT ["celery", "-A", "workers.celery_worker", "worker", "--loglevel=info"]
